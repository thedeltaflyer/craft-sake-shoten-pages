{
  "name": "craft-sake-shoten",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "verify:build": "node scripts/verify-build.mjs",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-assets.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json",
    "build:cloudflare": "npm run check && npm run build && npm run verify:build",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "test:worker": "node --experimental-strip-types --test tests/contact-worker.test.ts",
    "dev:worker": "wrangler dev --port 8787 --local"
  },
  "dependencies": {
    "astro": "7.3.3",
    "i18next": "26.4.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "5.9.3",
    "wrangler": "4.136.1"
  }
}
