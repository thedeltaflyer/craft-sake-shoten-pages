---
import Text from "./Text.astro";
import InstagramLink from "./InstagramLink.astro";
import { shops, topics, limits, type Shop } from "../contact/schema";
interface Props {
  shop?: Shop;
}
const { shop } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<form
  class="contact-form"
  data-contact
  data-site-key={siteKey}
  action="/api/contact"
  method="post"
  aria-label="Contact"
  data-i18n-aria-label="contact"
>
  {(["name", "email"] as const).map((field) => (
    <div class="field">
      <label for={`contact-${field}`}>
        <Text k={`form.${field}`} />
      </label>
      <input
        id={`contact-${field}`}
        name={field}
        type={field === "email" ? "email" : "text"}
        autocomplete={field}
        required
        maxlength={limits[field]}
        aria-describedby={`error-${field}`}
      />
      <span class="field-error" id={`error-${field}`} data-error={field}></span>
    </div>
  ))}
  {shop ? (
    <input type="hidden" name="shop" value={shop} />
  ) : (
    <div class="field">
      <label for="contact-shop">
        <Text k="form.shop" />
      </label>
      <select
        id="contact-shop"
        name="shop"
        required
        aria-describedby="error-shop"
      >
        <option value="" data-i18n="form.choose">
          Choose an option
        </option>
        {shops.map((id) => (
          <option value={id} data-i18n={id}>
            {id === "yokohama" ? "Yokohama" : "Kawasaki"}
          </option>
        ))}
      </select>
      <span class="field-error" id="error-shop" data-error="shop"></span>
    </div>
  )}
  <div class="field">
    <label for="contact-topic">
      <Text k="form.topic" />
    </label>
    <select
      id="contact-topic"
      name="topic"
      required
      aria-describedby="error-topic"
    >
      <option value="" data-i18n="form.choose">
        Choose an option
      </option>
      {topics.map((topic) => (
        <option value={topic} data-i18n={`form.topics.${topic}`}>
          {
            {
              questions: "Questions",
              feedback: "Feedback",
              "private-reservation": "Private Reservation",
              other: "Other",
            }[topic]
          }
        </option>
      ))}
    </select>
    <span class="field-error" id="error-topic" data-error="topic"></span>
  </div>
  <div class="field">
    <label for="contact-message">
      <Text k="form.message" />
    </label>
    <textarea
      id="contact-message"
      name="message"
      required
      maxlength={limits.message}
      rows="6"
      aria-describedby="error-message"
    ></textarea>
    <span class="field-error" id="error-message" data-error="message"></span>
  </div>
  <div class="honeypot" aria-hidden="true" inert>
    <label for="contact-website">Website</label>
    <input
      id="contact-website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
      maxlength="200"
    />
  </div>
  <div class="verification" data-turnstile hidden></div>
  <p
    data-contact-status
    role="status"
    aria-live="polite"
    data-i18n="form.status.initial"
  >
    Sending requires JavaScript and verification. You can also contact us on
    Instagram.
  </p>
  <div class="form-actions">
    <button type="submit" class="button" disabled>
      <Text k="form.send" />
    </button>
    <button type="button" data-retry hidden>
      <Text k="form.retry" />
    </button>
  </div>
  <div class="contact-links">
    {(shop ? [shop] : shops).map((id) => (
      <InstagramLink id={id} showName />
    ))}
  </div>
</form>
<script>
  import "../contact/client";
</script>
<style>
  .contact-form {
    min-width: 0;
    width: 100%;
  }
  .field {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  label {
    font-weight: 600;
  }
  input,
  select,
  textarea {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0.7rem;
    border: 1px solid currentColor;
    border-radius: 4px;
    background: #fff;
    color: #252a22;
    font: inherit;
  }
  textarea {
    resize: vertical;
  }
  [aria-invalid="true"] {
    border: 2px solid #9b2727;
  }
  .field-error {
    color: #9b2727;
    font-size: 0.9rem;
  }
  .field-error:empty {
    display: none;
  }
  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .verification {
    min-height: 150px;
  }
  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1rem 0;
  }
  button {
    min-height: 44px;
    padding: 0.7rem 1rem;
    font: inherit;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  [data-contact-status] {
    overflow-wrap: anywhere;
  }
</style>
