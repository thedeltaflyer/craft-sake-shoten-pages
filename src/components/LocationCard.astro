---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { locations, type LocationId } from "../data/locations";
import Text from "./Text.astro";
interface Props {
  id: LocationId;
  image?: ImageMetadata;
}
const { id } = Astro.props;
const shop = locations[id];
const image = Astro.props.image ?? shop.image;
---

<article class="shop-card">
  <a class="card-image" href={`/${id}/`} tabindex="-1" aria-hidden="true">
    <Image
      src={image}
      alt=""
      widths={[400, 640, Math.min(960, image.width)]}
      sizes="(max-width: 700px) 100vw, 50vw"
      loading="lazy"
    />
  </a>
  <div class="card-body">
    <Text as="h3" k={id} />
    <Text as="p" k={`${id}Page.card`} />
    <a class="text-link" href={`/${id}/`}>
      <Text k={`${id}Explore`} /> <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
