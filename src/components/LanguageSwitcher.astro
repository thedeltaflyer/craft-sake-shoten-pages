---
import { t } from "../i18n";
---

<div
  class="language-switcher"
  data-language-switcher
  hidden
  role="group"
  aria-label={t("language")}
  data-i18n-aria-label="language"
>
  <button type="button" lang="ja" data-language="ja" aria-pressed="false">
    日本語
  </button>
  <button type="button" lang="en" data-language="en" aria-pressed="true">
    English
  </button>
</div>
<noscript>
  <p class="noscript">
    <span lang="ja">{t("noscriptJa")}</span>{" "}
    <span lang="en">{t("noscriptEn")}</span>
  </p>
</noscript>
